# API Configuration
PROJECT_NAME="AI Gym & Fitness Assistant"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security
SECRET_KEY="change-this-in-production-use-a-strong-secret-key-32-bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# Database (PostgreSQL Async)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="ai_gym_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/ai_gym_db"

# Redis Cache & Sessions
REDIS_URL="redis://localhost:6379/0"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
