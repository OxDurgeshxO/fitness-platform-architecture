# ==============================================================================
# AI Biomechanical Fitness Platform - Environment Configuration
# Copy this file to .env and replace placeholder values for local development.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Next.js Web Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:8080

# Realtime WebSocket Telemetry Service
REALTIME_PORT=8080
REALTIME_METRICS_PORT=9121
LOG_LEVEL=info

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=ai_gym_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/ai_gym_db

# Redis Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Fast API Backend Configuration
PROJECT_NAME="AI Gym & Fitness Assistant"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider API Keys (Optional - Local mock fallback is active by default)
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Telemetry & Observability
OTEL_SERVICE_NAME=fitness-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_ENABLED=true
