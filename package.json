{
  "name": "@fitness/platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI Biomechanical Fitness Platform - Monorepo",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "tsx --test tests/**/*.test.ts",
    "dev": "pnpm --filter web dev"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
